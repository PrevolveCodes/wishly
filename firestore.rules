rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(code) {
      return signedIn()
        && exists(/databases/$(database)/documents/wishlists/$(code))
        && get(/databases/$(database)/documents/wishlists/$(code)).data.ownerUid == request.auth.uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isGiftGiver() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hasGiftAccess(code) {
      return isGiftGiver()
        && exists(/databases/$(database)/documents/wishlists/$(code)/giftAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/wishlists/$(code)/giftAccess/$(request.auth.uid)).data.active == true;
    }

    match /wishlists/{code} {
      allow get: if true;
      allow list: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['code', 'ownerUid', 'ownerName', 'title', 'occasion', 'createdAt', 'coverImageUrl', 'themeColor', 'eventDate', 'customMessage'])
        && request.resource.data.code == code
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update: if isOwner(code)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.code == resource.data.code;
      allow delete: if isOwner(code);

      match /items/{itemId} {
        allow get, list: if exists(/databases/$(database)/documents/wishlists/$(code));
        allow create: if isOwner(code)
          && request.resource.data.keys().hasOnly(['name', 'category', 'url', 'imageUrl', 'price', 'priority', 'notes', 'createdAt', 'sortOrder'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
        allow update: if isOwner(code)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.keys().hasOnly(['name', 'category', 'url', 'imageUrl', 'price', 'priority', 'notes', 'createdAt']);
        allow delete: if isOwner(code);
      }

      match /giftAccessConfig/{configId} {
        allow get, list: if false;
        allow create: if isGiftGiver()
          && configId == 'main'
          && !exists(/databases/$(database)/documents/wishlists/$(code)/giftAccessConfig/main)
          && request.resource.data.keys().hasOnly(['pinHash', 'createdAt'])
          && request.resource.data.pinHash is string
          && request.resource.data.pinHash.size() == 64;
        allow update, delete: if false;
      }

      match /giftAccess/{uid} {
        allow get: if isGiftGiver()
          && request.auth.uid == uid
          && resource.data.active == true;
        allow list: if false;
        allow create: if isGiftGiver()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['pinHash', 'active', 'createdAt'])
          && request.resource.data.pinHash is string
          && request.resource.data.pinHash.size() == 64
          && request.resource.data.active == true
          && exists(/databases/$(database)/documents/wishlists/$(code)/giftAccessConfig/main)
          && request.resource.data.pinHash == get(/databases/$(database)/documents/wishlists/$(code)/giftAccessConfig/main).data.pinHash;
        allow update: if isGiftGiver()
          && request.auth.uid == uid
          && resource.data.active == true
          && request.resource.data.keys().hasOnly(['pinHash', 'active', 'createdAt'])
          && request.resource.data.pinHash == resource.data.pinHash
          && request.resource.data.active == true;
        allow delete: if false;
      }

      match /purchases/{itemId} {
        allow get, list: if hasGiftAccess(code)
          && exists(/databases/$(database)/documents/wishlists/$(code)/items/$(itemId));
        allow create, update: if hasGiftAccess(code)
          && exists(/databases/$(database)/documents/wishlists/$(code)/items/$(itemId))
          && request.resource.data.keys().hasOnly(['purchased', 'updatedAt'])
          && request.resource.data.purchased == true;
        allow delete: if false;
      }

      match /reservations/{itemId} {
        allow get, list: if hasGiftAccess(code)
          && exists(/databases/$(database)/documents/wishlists/$(code)/items/$(itemId));
        allow create: if hasGiftAccess(code)
          && exists(/databases/$(database)/documents/wishlists/$(code)/items/$(itemId))
          && request.resource.data.keys().hasOnly(['reserved', 'reservedBy', 'updatedAt'])
          && request.resource.data.reserved == true
          && request.resource.data.reservedBy == request.auth.uid;
        allow update: if hasGiftAccess(code)
          && resource.data.reservedBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['reserved', 'reservedBy', 'updatedAt'])
          && request.resource.data.reserved == true
          && request.resource.data.reservedBy == request.auth.uid;
        allow delete: if hasGiftAccess(code) && resource.data.reservedBy == request.auth.uid;
      }
    }
  }
}
